<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <include layout="@layout/item_candidato" android:id="@+id/tvNomeCandidato1"/>
            <include layout="@layout/item_candidato" android:id="@+id/tvNomeCandidato2"/>
            <include layout="@layout/item_candidato" android:id="@+id/tvNomeCandidato3"/>
            <include layout="@layout/item_candidato" android:id="@+id/tvNomeCandidato4"/>
            <include layout="@layout/item_candidato" android:id="@+id/tvNomeCandidato5"/>

            <Space
                android:layout_width="match_parent"
                android:layout_height="40dp" />

            <include layout="@layout/item_candidato" android:id="@+id/tvBranco"/>
            <include layout="@layout/item_candidato" android:id="@+id/tvNulo"/>
            <include layout="@layout/item_candidato" android:id="@+id/tvNaoSei"/>

            <Space
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <Button
                android:id="@+id/btnConfirmar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Confirmar"
                android:backgroundTint="#0000FF"
                android:textColor="#FFFFFF" />

        </LinearLayout>

    </ScrollView>





</androidx.constraintlayout.widget.ConstraintLayout>