<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<!--//Primeiro Candidato configurado Luffy-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@drawable/borda_espontanea"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        tools:ignore="MissingConstraints">


        <CheckBox
            android:id="@+id/checkCandidato1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false" />

        <ImageView
            android:id="@+id/imgCandidato1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/candidato1"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvNomeCandidato1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monkey D. Luffy"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDesenho1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="One Piece" />

        </LinearLayout>
    </LinearLayout>

